{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Obsidian Mod Manager",
  "mainBinaryName": "Obsidian",
  "version": "1.0.0",
  "identifier": "io.github.alomare.obsidianmodmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Obsidian",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": [] },
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../loader/src/": "loader/src/",
      "../../loader/fonts/": "loader/fonts/",
      "../../bundled/": "bundled/",
      "../../locales/": "locales/",
      "../../target/luajit/luajit.exe": "luajit/luajit.exe",
      "../../target/luajit/lua/": "luajit/lua/",
      "../../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "languages": [
          "English",
          "PortugueseBR",
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFMDk3NEVCQ0Q4M0YwMTAKUldRUThJUE42M1FKem84YlozRG44OUJuenJvRzNGeE9sajE4R2NpeHFXY3NoZEtUdEtuSmtIbFkK",
      "endpoints": [
        "https://github.com/Alomare/ObsidianModManager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
